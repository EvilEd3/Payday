#PUBLIC_URL=https://payday.example.co.nz
#ALLOWED_HOSTS=

# SQLite (one machine) or PostgreSQL
DATABASE_URL=sqlite:////data/budget.db
#DATABASE_URL=postgresql://payday:password@db.example.com:5432/payday

# Shared key for several copies of the app (otherwise /data/payday.key is used)
#PAYDAY_KEY=

# Akahu Full App (Connect your bank)
#AKAHU_CLIENT_ID=app_token_...
#AKAHU_CLIENT_SECRET=

# Email
#SMTP_HOST=smtp.postmarkapp.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=hello@example.co.nz
#SMTP_SECURITY=starttls

PAYDAY_DAY=15
PAYDAY_ADJUST=previous_business_day
SYNC_HOUR=6
TZ_NAME=Pacific/Auckland
